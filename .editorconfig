# Coding standards: Docs/CODING_STANDARDS.md. Naming violations surface as
# warnings (IDE1006) in VS Code.
root = true

[*]
charset = utf-8
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

[*.{yml,yaml,md}]
indent_size = 2

[*.md]
# Two trailing spaces are a Markdown line break
trim_trailing_whitespace = false

# Unity-serialized files: leave exactly as Unity writes them
# (e.g. "m_Name: " keeps its trailing space)
[*.{unity,prefab,asset,meta,mat,anim,controller,overrideController,physicMaterial,mask,playable,signal,mixer,lighting,preset,renderTexture,spriteatlasv2,inputactions,asmdef,asmref}]
indent_size = unset
insert_final_newline = unset
trim_trailing_whitespace = unset

# Package and build output (e.g. Library/PackageCache): not our code, so
# analyzers skip it instead of flagging third-party naming.
[{Library,Temp,obj}/**.cs]
generated_code = true

[*.cs]
# Unity 6.3 compiles C# 9: file-scoped namespaces (C# 10) fail with CS8773
csharp_style_namespace_declarations = block_scoped:warning
csharp_new_line_before_open_brace = all
csharp_prefer_braces = true:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_for_built_in_types = false:suggestion
dotnet_sort_system_directives_first = true
dotnet_style_qualification_for_field = false:suggestion
dotnet_style_qualification_for_property = false:suggestion
dotnet_style_qualification_for_method = false:suggestion
dotnet_style_qualification_for_event = false:suggestion
dotnet_style_require_accessibility_modifiers = for_non_interface_members:suggestion
dotnet_style_readonly_field = true:suggestion

# Severities as diagnostics too, so the rules also apply in command-line
# builds, not only in the editor. (Roslyn naming rules skip enum members,
# so their PascalCase rule is documented, not enforced.)
dotnet_diagnostic.IDE1006.severity = warning   # naming rules
dotnet_diagnostic.IDE0160.severity = warning   # use block-scoped namespace

# ---------------------------------------------------------------- Naming
# Roslyn orders rules by specificity, not file order.

# Constants (includes enum members): PascalCase
dotnet_naming_rule.constants_pascal.symbols = constants
dotnet_naming_rule.constants_pascal.style = pascal_case
dotnet_naming_rule.constants_pascal.severity = warning
dotnet_naming_symbols.constants.applicable_kinds = field
dotnet_naming_symbols.constants.required_modifiers = const

# Private/internal static fields: s_camelCase
dotnet_naming_rule.private_static_fields_s_prefix.symbols = private_static_fields
dotnet_naming_rule.private_static_fields_s_prefix.style = s_camel_case
dotnet_naming_rule.private_static_fields_s_prefix.severity = warning
dotnet_naming_symbols.private_static_fields.applicable_kinds = field
dotnet_naming_symbols.private_static_fields.applicable_accessibilities = private, internal, private_protected
dotnet_naming_symbols.private_static_fields.required_modifiers = static

# Private/internal instance fields: _camelCase (the Inspector hides the underscore)
dotnet_naming_rule.private_fields_underscore.symbols = private_fields
dotnet_naming_rule.private_fields_underscore.style = underscore_camel_case
dotnet_naming_rule.private_fields_underscore.severity = warning
dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private, internal, private_protected

# Public/protected fields: PascalCase
dotnet_naming_rule.public_fields_pascal.symbols = public_fields
dotnet_naming_rule.public_fields_pascal.style = pascal_case
dotnet_naming_rule.public_fields_pascal.severity = warning
dotnet_naming_symbols.public_fields.applicable_kinds = field
dotnet_naming_symbols.public_fields.applicable_accessibilities = public, protected, protected_internal

# Interfaces: IPascalCase
dotnet_naming_rule.interfaces_i_prefix.symbols = interfaces
dotnet_naming_rule.interfaces_i_prefix.style = i_prefix_pascal_case
dotnet_naming_rule.interfaces_i_prefix.severity = warning
dotnet_naming_symbols.interfaces.applicable_kinds = interface

# Type parameters: TPascalCase
dotnet_naming_rule.type_parameters_t_prefix.symbols = type_parameters
dotnet_naming_rule.type_parameters_t_prefix.style = t_prefix_pascal_case
dotnet_naming_rule.type_parameters_t_prefix.severity = warning
dotnet_naming_symbols.type_parameters.applicable_kinds = type_parameter

# Types and members: PascalCase
dotnet_naming_rule.types_members_pascal.symbols = types_members
dotnet_naming_rule.types_members_pascal.style = pascal_case
dotnet_naming_rule.types_members_pascal.severity = warning
dotnet_naming_symbols.types_members.applicable_kinds = namespace, class, struct, enum, delegate, method, local_function, property, event

# Parameters and locals: camelCase
dotnet_naming_rule.params_locals_camel.symbols = params_locals
dotnet_naming_rule.params_locals_camel.style = camel_case
dotnet_naming_rule.params_locals_camel.severity = warning
dotnet_naming_symbols.params_locals.applicable_kinds = parameter, local

dotnet_naming_style.pascal_case.capitalization = pascal_case
dotnet_naming_style.camel_case.capitalization = camel_case
dotnet_naming_style.underscore_camel_case.capitalization = camel_case
dotnet_naming_style.underscore_camel_case.required_prefix = _
dotnet_naming_style.s_camel_case.capitalization = camel_case
dotnet_naming_style.s_camel_case.required_prefix = s_
dotnet_naming_style.i_prefix_pascal_case.capitalization = pascal_case
dotnet_naming_style.i_prefix_pascal_case.required_prefix = I
dotnet_naming_style.t_prefix_pascal_case.capitalization = pascal_case
dotnet_naming_style.t_prefix_pascal_case.required_prefix = T
