/* Generated by TCG > Generate Prototype Card Data. Colours are preview defaults from the Rarity
   Palette; CardTemplate.Bind applies the palette at runtime. */
.card {
    width: 250px;
    height: 350px;
    padding: 12px;
    border-width: 8px;
    border-radius: 16px;
    border-color: rgb(154, 163, 173);
    background-color: rgb(27, 31, 36);
}

.card__id {
    position: absolute;
    top: 8px;
    right: 12px;
    font-size: 11px;
    color: rgba(242, 242, 242, 0.6);
}

.card__face {
    flex-grow: 1;
    justify-content: center;
    align-items: center;
}

.card__name {
    font-size: 26px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    white-space: normal;
    color: rgb(242, 242, 242);
}

.card__tier {
    margin-top: 10px;
    font-size: 18px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: rgb(154, 163, 173);
}
