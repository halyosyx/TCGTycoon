.hud {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    justify-content: center;
    align-items: center;
}

.hud__crosshair {
    width: 8px;
    height: 8px;
    border-radius: 4px;
    border-width: 1px;
    border-color: rgba(27, 31, 36, 0.8);
    background-color: rgba(242, 242, 242, 0.9);
}
