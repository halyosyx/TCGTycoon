<!-- DEV ONLY. Every product-card and cart-panel state side by side, for UI Builder and for visual checks.
     State classes are put on a wrapper (an ancestor), exactly as the runtime puts them on #store-site / the card root. -->
<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="/Assets/_Project/UI/Styles/Tokens.uss" />
    <Style src="/Assets/_Project/UI/Styles/Typography.uss" />
    <Style src="/Assets/_Project/UI/Styles/Icons.uss" />
    <Style src="/Assets/_Project/UI/Store/StoreTokens.uss" />
    <Style src="/Assets/_Project/UI/Store/StoreSite.uss" />
    <Style src="/Assets/_Project/UI/Store/StoreProductCard.uss" />
    <Style src="/Assets/_Project/UI/Store/StoreCartPanel.uss" />
    <Style src="/Assets/_Project/UI/Controls/QuantityStepper.uss" />
    <ui:Template name="Card" src="/Assets/_Project/UI/Store/StoreProductCard.uxml" />
    <ui:Template name="CartPanel" src="/Assets/_Project/UI/Store/StoreCartPanel.uxml" />
    <ui:Template name="CartLine" src="/Assets/_Project/UI/Store/StoreCartLine.uxml" />
    <ui:ScrollView class="site-store store" style="flex-grow: 1;">
        <ui:Label text="Product card: default · focused · coming soon · sold out" style="font-size: 20px; margin: 16px 24px 0 24px;" />
        <ui:VisualElement style="width: 1600px; flex-direction: row; flex-wrap: wrap; padding: 11px 15px;">
            <ui:Instance template="Card" />
            <ui:Instance template="Card" class="store-product--focused" />
            <ui:Instance template="Card" class="store-product--soon" />
            <ui:Instance template="Card" class="store-product--sold-out" />
        </ui:VisualElement>
        <ui:Label text="Cart panel: with items · over balance · empty · order placed" style="font-size: 20px; margin: 16px 24px 0 24px;" />
        <ui:VisualElement style="flex-direction: row; padding: 16px 24px;">
            <ui:VisualElement class="store store--cart-shown store--cart-open" style="width: 460px; height: 640px; margin-right: 24px;">
                <ui:Instance template="CartPanel" class="store-cart-host" />
            </ui:VisualElement>
            <ui:VisualElement class="store store--cart-shown store--cart-open store--over" style="width: 460px; height: 640px; margin-right: 24px;">
                <ui:Instance template="CartPanel" class="store-cart-host" />
            </ui:VisualElement>
            <ui:VisualElement class="store store--cart-shown store--cart-open store--cart-empty" style="width: 460px; height: 640px; margin-right: 24px;">
                <ui:Instance template="CartPanel" class="store-cart-host" />
            </ui:VisualElement>
            <ui:VisualElement class="store store--cart-shown store--cart-open store--order-placed" style="width: 460px; height: 640px;">
                <ui:Instance template="CartPanel" class="store-cart-host" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:Label text="Cart line" style="font-size: 20px; margin: 16px 24px 0 24px;" />
        <ui:VisualElement style="width: 412px; padding: 0 24px 24px 24px; background-color: rgb(255, 255, 255); margin-left: 24px;">
            <ui:Instance template="CartLine" />
        </ui:VisualElement>
    </ui:ScrollView>
</ui:UXML>
