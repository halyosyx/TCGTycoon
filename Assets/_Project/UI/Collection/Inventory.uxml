<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="Inventory.uss" />
    <ui:VisualElement name="inventory" class="inventory">
        <ui:VisualElement class="inventory__panel">
            <ui:VisualElement class="inventory__header">
                <ui:Label text="Inventory" class="inventory__title" />
                <ui:Label name="inventory-summary" text="0 cards in 0 stacks" class="inventory__summary" />
                <ui:Button name="inventory-close" text="Close" class="inventory__close" focusable="false" />
            </ui:VisualElement>
            <ui:VisualElement class="inventory-row inventory-row--heading">
                <ui:Label text="Tier" class="inventory-row__tier" />
                <ui:Label text="Card" class="inventory-row__name" />
                <ui:Label text="Count" class="inventory-row__count" />
            </ui:VisualElement>
            <ui:Label name="inventory-empty" text="No cards yet. Open a pack!" class="inventory__empty" />
            <ui:ListView name="inventory-list" class="inventory__list" />
            <ui:Label text="I or Esc to close" class="inventory__hint" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
